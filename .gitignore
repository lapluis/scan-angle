# Rust / Cargo
# Build artifacts
/target
/debug

# Backup files generated by rustfmt
**/*.rs.bk

# Mutation testing output (cargo-mutants)
**/mutants.out*/

# MSVC (Windows) debug symbol files
*.pdb

# IDE / Editor
# JetBrains RustRover / IntelliJ IDEA
.idea/

# VSCode
.vscode/

# Packaged application and local analysis results
/dist/
/results/
/*_角度结果/

# Test-fixture generator environment and bytecode
/.venv/
__pycache__/
*.py[cod]

# Deterministic images generated by scripts/generate-fixtures.py
/tests/fixtures/**/*.png
/tests/fixtures/**/*.jpg
/tests/fixtures/**/*.bmp
/tests/fixtures/**/*.webp
/tests/fixtures/**/*.tif
